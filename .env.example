# Tenant developer key from https://go.terminal3.io/adk-community (shown ONCE)
# Do NOT commit real values. Export in your shell instead of writing to .env if preferred:
#   export T3N_API_KEY="0x..."
T3N_API_KEY=

# Separate agent key — claim a SECOND key from the same page for the agent identity.
# Never reuse T3N_API_KEY here. See docs: Register a Public Agent.
AGENT_KEY=

# Optional: override env name for scripts that call setEnvironment (default: testnet)
T3N_ENV=testnet
