{
  "name": "t3n-support-triage-agent",
  "version": "0.1.0",
  "description": "T3N support triage / enterprise ops agent for Superteam T3N Agent Build Challenge",
  "scripts": {
    "offline:triage": "node scripts/offline-triage.mjs",
