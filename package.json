    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "data",
    "scripts",
    "README.md",
    "AGENTS.md",
    ".cursorrules",
    "agent-card.template.json",
